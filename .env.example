# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexora_hrms?schema=public"

# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Set to false in production if staff accounts must be created by HR only
ALLOW_REGISTRATION=true

# --- Auth (use long random strings: `openssl rand -hex 64`) ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=7
JWT_REFRESH_DAYS_REMEMBER=30
BCRYPT_ROUNDS=12

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# --- File storage (local in development) ---
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
