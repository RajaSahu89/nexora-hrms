generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ ENUMS ============================
enum RoleName { SUPER_ADMIN HR_ADMIN MANAGER EMPLOYEE }
enum Gender { MALE FEMALE OTHER PREFER_NOT_TO_SAY }
enum EmploymentType { FULL_TIME PART_TIME CONTRACT INTERN }
enum EmploymentStatus { ACTIVE INACTIVE ON_LEAVE TERMINATED RESIGNED }
enum AttendanceStatus { PRESENT ABSENT LATE HALF_DAY ON_LEAVE HOLIDAY }
enum CorrectionStatus { NONE PENDING APPROVED REJECTED }
enum LeaveStatus { PENDING APPROVED REJECTED CANCELLED }
enum PayrollStatus { ESTIMATED FINALIZED PAID }
enum ComponentType { EARNING DEDUCTION }
enum AmountType { FIXED PERCENT }
enum VacancyStatus { DRAFT OPEN CLOSED }
enum ApplicationStage { APPLIED SCREENING SHORTLISTED INTERVIEW SELECTED REJECTED HIRED }
enum InterviewStatus { SCHEDULED COMPLETED CANCELLED NO_SHOW }
enum ReviewStatus { DRAFT SELF_ASSESSMENT MANAGER_REVIEW COMPLETED }
enum GoalStatus { NOT_STARTED IN_PROGRESS COMPLETED CANCELLED }
enum TaskStatus { TODO IN_PROGRESS UNDER_REVIEW COMPLETED }
enum TaskPriority { LOW MEDIUM HIGH URGENT }
enum DocumentCategory { OFFER_LETTER APPOINTMENT_LETTER EXPERIENCE_CERTIFICATE IDENTITY POLICY OTHER }
enum DocumentVisibility { PRIVATE_EMPLOYEE HR_ONLY ALL_EMPLOYEES }
enum AnnouncementType { GENERAL IMPORTANT HOLIDAY EVENT }
enum NotificationType {
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_REQUESTED
  ATTENDANCE_ALERT
  TASK_ASSIGNED
  TASK_DEADLINE
  PAYROLL_UPDATE
  ANNOUNCEMENT
  DOCUMENT_EXPIRY
  SYSTEM
}

// ====================== AUTH & ACCESS ======================
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  roleId             String
  role               Role      @relation(fields: [roleId], references: [id])
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee           Employee?
  sessions           Session[]
  resetTokens        PasswordResetToken[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  announcements      Announcement[]

  @@index([roleId])
}

model Role {
  id          String       @id @default(cuid())
  name        RoleName     @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  permissions Permission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]
}

// Supporting auth tables (refresh sessions, password reset)
model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

// ===================== ORGANISATION =====================
model Employee {
  id                    String           @id @default(cuid())
  employeeCode          String           @unique
  userId                String?          @unique
  user                  User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName             String
  lastName              String
  email                 String           @unique
  phone                 String?
  dateOfBirth           DateTime?        @db.Date
  gender                Gender?
  address               String?
  photoUrl              String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRel   String?

  departmentId          String?
  department            Department?      @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  designationId         String?
  designation           Designation?     @relation(fields: [designationId], references: [id], onDelete: SetNull)
  managerId             String?
  manager               Employee?        @relation("ReportingLine", fields: [managerId], references: [id], onDelete: SetNull)
  reports               Employee[]       @relation("ReportingLine")
  joiningDate           DateTime         @db.Date
  employmentType        EmploymentType   @default(FULL_TIME)
  employmentStatus      EmploymentStatus @default(ACTIVE)
  workLocation          String?

  education             Json?
  skills                String[]
  experience            Json?
  bankDetails           Json?

  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  headOfDepartment      Department?      @relation("DepartmentHead")
  attendance            Attendance[]
  leaveRequests         LeaveRequest[]   @relation("LeaveApplicant")
  leavesDecided         LeaveRequest[]   @relation("LeaveApprover")
  leaveBalances         LeaveBalance[]
  payrolls              Payroll[]
  salaryComponents      SalaryComponent[]
  reviewsReceived       PerformanceReview[] @relation("ReviewEmployee")
  reviewsGiven          PerformanceReview[] @relation("ReviewReviewer")
  goals                 EmployeeGoal[]
  tasksAssigned         Task[]           @relation("TaskAssignee")
  tasksCreated          Task[]           @relation("TaskCreator")
  taskComments          TaskComment[]
  documents             Document[]       @relation("DocumentOwner")
  documentsUploaded     Document[]       @relation("DocumentUploader")
  interviewsTaken       Interview[]

  @@index([departmentId])
  @@index([designationId])
  @@index([managerId])
  @@index([employmentStatus])
  @@index([lastName, firstName])
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  budget      Decimal?   @db.Decimal(14, 2)
  headId      String?    @unique
  head        Employee?  @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  employees     Employee[]     @relation("DepartmentMembers")
  vacancies     JobVacancy[]
  announcements Announcement[]
}

model Designation {
  id        String       @id @default(cuid())
  title     String       @unique
  level     Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  employees Employee[]
  vacancies JobVacancy[]
}

// ======================= ATTENDANCE =======================
model Attendance {
  id               String           @id @default(cuid())
  employeeId       String
  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date             DateTime         @db.Date
  checkIn          DateTime?
  checkOut         DateTime?
  status           AttendanceStatus @default(PRESENT)
  workedMinutes    Int              @default(0)
  overtimeMinutes  Int              @default(0)
  isLate           Boolean          @default(false)
  isEarlyDeparture Boolean          @default(false)
  note             String?
  correctionStatus CorrectionStatus @default(NONE)
  correctionReason String?
  correctedById    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  breaks           AttendanceBreak[]

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
}

model AttendanceBreak {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  startedAt    DateTime
  endedAt      DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([attendanceId])
}

// ========================= LEAVE =========================
model LeaveType {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String   @unique
  defaultDays  Decimal  @default(0) @db.Decimal(5, 1)
  isPaid       Boolean  @default(true)
  carryForward Boolean  @default(false)
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests     LeaveRequest[]
  balances     LeaveBalance[]
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation("LeaveApplicant", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  days         Decimal     @db.Decimal(5, 1)
  reason       String
  status       LeaveStatus @default(PENDING)
  approverId   String?
  approver     Employee?   @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([employeeId, status])
  @@index([startDate, endDate])
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year        Int
  allocated   Decimal   @default(0) @db.Decimal(5, 1)
  used        Decimal   @default(0) @db.Decimal(5, 1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
}

// ======================== PAYROLL ========================
model Payroll {
  id            String        @id @default(cuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  basicSalary   Decimal       @db.Decimal(12, 2)
  hra           Decimal       @default(0) @db.Decimal(12, 2)
  allowances    Decimal       @default(0) @db.Decimal(12, 2)
  bonuses       Decimal       @default(0) @db.Decimal(12, 2)
  overtimePay   Decimal       @default(0) @db.Decimal(12, 2)
  deductions    Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  grossPay      Decimal       @db.Decimal(12, 2)
  netPay        Decimal       @db.Decimal(12, 2)
  status        PayrollStatus @default(ESTIMATED)
  finalizedAt   DateTime?
  finalizedById String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payslip       Payslip?

  @@unique([employeeId, month, year])
  @@index([year, month])
  @@index([status])
}

model SalaryComponent {
  id            String        @id @default(cuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name          String
  type          ComponentType
  amountType    AmountType    @default(FIXED)
  amount        Decimal       @db.Decimal(12, 2)
  effectiveFrom DateTime      @db.Date
  effectiveTo   DateTime?     @db.Date
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([employeeId, effectiveFrom])
}

model Payslip {
  id          String   @id @default(cuid())
  payrollId   String   @unique
  payroll     Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  pdfPath     String?
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===================== RECRUITMENT =====================
model JobVacancy {
  id             String         @id @default(cuid())
  title          String
  description    String
  requirements   String?
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId  String?
  designation    Designation?   @relation(fields: [designationId], references: [id], onDelete: SetNull)
  location       String?
  employmentType EmploymentType @default(FULL_TIME)
  openings       Int            @default(1)
  status         VacancyStatus  @default(OPEN)
  closingDate    DateTime?      @db.Date
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  applications   Application[]

  @@index([status])
}

model Candidate {
  id              String   @id @default(cuid())
  fullName        String
  email           String   @unique
  phone           String?
  resumePath      String?
  skills          String[]
  experienceYears Decimal? @db.Decimal(4, 1)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications    Application[]
}

model Application {
  id          String           @id @default(cuid())
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  vacancyId   String
  vacancy     JobVacancy       @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  stage       ApplicationStage @default(APPLIED)
  position    Int              @default(0)
  coverNote   String?
  appliedAt   DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  interviews  Interview[]

  @@unique([candidateId, vacancyId])
  @@index([vacancyId, stage])
}

model Interview {
  id            String          @id @default(cuid())
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId String?
  interviewer   Employee?       @relation(fields: [interviewerId], references: [id], onDelete: SetNull)
  scheduledAt   DateTime
  mode          String?
  location      String?
  status        InterviewStatus @default(SCHEDULED)
  rating        Int?
  feedback      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([applicationId])
  @@index([scheduledAt])
}

// ====================== PERFORMANCE ======================
model PerformanceReview {
  id              String       @id @default(cuid())
  employeeId      String
  employee        Employee     @relation("ReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId      String?
  reviewer        Employee?    @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  periodStart     DateTime     @db.Date
  periodEnd       DateTime     @db.Date
  status          ReviewStatus @default(DRAFT)
  selfAssessment  String?
  managerFeedback String?
  rating          Decimal?     @db.Decimal(3, 1)
  kpiScores       Json?
  improvementPlan String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([employeeId, periodEnd])
}

model EmployeeGoal {
  id           String     @id @default(cuid())
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  targetValue  Decimal?   @db.Decimal(12, 2)
  currentValue Decimal?   @db.Decimal(12, 2)
  progress     Int        @default(0)
  status       GoalStatus @default(NOT_STARTED)
  dueDate      DateTime?  @db.Date
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([employeeId, status])
}

// ========================== TASKS ==========================
model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  progress    Int          @default(0)
  dueDate     DateTime?
  position    Int          @default(0)
  attachments String[]
  assigneeId  String?
  assignee    Employee?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId   String
  creator     Employee     @relation("TaskCreator", fields: [creatorId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  comments    TaskComment[]

  @@index([assigneeId, status])
  @@index([dueDate])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    Employee @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

// ========================= DOCUMENTS =========================
model Document {
  id           String             @id @default(cuid())
  title        String
  category     DocumentCategory   @default(OTHER)
  filePath     String
  mimeType     String
  sizeBytes    Int
  visibility   DocumentVisibility @default(PRIVATE_EMPLOYEE)
  employeeId   String?
  employee     Employee?          @relation("DocumentOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   Employee?          @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  expiresAt    DateTime?          @db.Date
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([employeeId, category])
  @@index([expiresAt])
}

// ============== ANNOUNCEMENTS & NOTIFICATIONS ==============
model Announcement {
  id            String           @id @default(cuid())
  title         String
  body          String
  type          AnnouncementType @default(GENERAL)
  departmentId  String?
  department    Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  publishedById String
  publishedBy   User             @relation(fields: [publishedById], references: [id])
  publishedAt   DateTime         @default(now())
  expiresAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([publishedAt])
  @@index([departmentId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, isRead, createdAt])
}

// ============== CALENDAR, AUDIT, SETTINGS ==============
model Holiday {
  id         String   @id @default(cuid())
  name       String
  date       DateTime @unique @db.Date
  isOptional Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model CompanySetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
